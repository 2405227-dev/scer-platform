
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}
model Notification {
  id        String   @id @default(cuid())
  message   String
  status    String
  createdAt DateTime @default(now())
}
model NotificationRule {
  id        String @id @default(cuid())
  condition String
  action    String
}
model NotificationRecipient {
  id    String @id @default(cuid())
  email String
}
model NotificationAttempt {
  id        String   @id @default(cuid())
  status    String
  createdAt DateTime @default(now())
}
model EscalationPolicy {
  id   String @id @default(cuid())
  name String
}
