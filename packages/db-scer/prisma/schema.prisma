
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}
model Organization {
  id        String   @id @default(cuid())
  name      String
  type      String
  users     User[]
  incidents Incident[]
  createdAt DateTime @default(now())
}
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique
  role           String
  createdAt      DateTime     @default(now())
}
model Incident {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  type           String
  severity       String
  status         String
  location       String
  description    String?
  events         IncidentEvent[]
  createdAt      DateTime        @default(now())
}
model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  type       String
  data       String?
  createdAt  DateTime @default(now())
}
model Responder {
  id             String   @id @default(cuid())
  name           String
  status         String
  createdAt      DateTime @default(now())
}
// Add other models as needed

model Resource {
  id        String   @id @default(cuid())
  name      String
  type      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  actor       String
  action      String
  description String
  createdAt   DateTime @default(now())
}
