generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      String
  users     User[]
  incidents Incident[]
  createdAt DateTime     @default(now())
}

model User {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String       @db.ObjectId
  organization       Organization @relation(fields: [organizationId], references: [id])
  name               String
  email              String       @unique
  passwordHash       String       @default("")
  role               String       @default("USER") // "USER" | "CONTROLLER"
  isRootController   Boolean      @default(false)
  isActive           Boolean      @default(true)
  isTempPassword     Boolean      @default(true)
  mustChangePassword Boolean      @default(true)
  phone              String?
  department         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt
}

model Incident {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String               @db.ObjectId
  organization     Organization         @relation(fields: [organizationId], references: [id])
  type             String
  severity         String
  status           String
  location         String
  description      String?
  events           IncidentEvent[]
  timeline         IncidentTimeline[]
  messages         IncidentMessage[]
  reporterId       String?
  reporterName     String?
  reporterTelegramChatId String?
  reporterTelegramMessageId String?
  telegramChatId   String?
  telegramMessageId String?
  assignedTo       String?
  assignedToName   String?
  assignedAt       DateTime?
  responderId      String?              @db.ObjectId
  responder        Responder?           @relation(fields: [responderId], references: [id])
  estimatedArrival DateTime?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  resolvedBy       String?
  priority         Int                  @default(1)
  tags             String               @default("")
  location_lat     Float?
  location_lon     Float?
  attachments      String               @default("[]")
  aiAnalysisStatus String?
  aiAnalysisSummary String?
  aiActionPlan     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model IncidentMessage {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  incidentId        String   @db.ObjectId
  incident          Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  senderType        String   // STUDENT | RESPONDER | SYSTEM
  senderName        String
  senderId          String?
  content           String
  telegramMessageId String?
  createdAt         DateTime @default(now())
}

model IncidentEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  incidentId String   @db.ObjectId
  incident   Incident @relation(fields: [incidentId], references: [id])
  type       String
  data       String?
  createdAt  DateTime @default(now())
}

model IncidentTimeline {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  incidentId String   @db.ObjectId
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  action     String
  actor      String
  details    String?
  createdAt  DateTime @default(now())
}

model Responder {
  id                  String                 @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  status              String
  email               String                 @unique
  phone               String?
  skills              String                 @default("[]")
  location_lat        Float?
  location_lon        Float?
  availability        Boolean                @default(true)
  telegramChatId      String?
  telegramUsername    String?
  telegramLinkToken   String?
  telegramConnectedAt DateTime?
  lastHeartbeat       DateTime               @default(now())
  assignedIncidents   Incident[]
  capabilities        ResponderCapability[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

model ResponderCapability {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  responderId String    @db.ObjectId
  responder   Responder @relation(fields: [responderId], references: [id], onDelete: Cascade)
  capability  String
  level       String
  certified   Boolean   @default(false)
  createdAt   DateTime  @default(now())
}


model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  timestamp   DateTime @default(now())
  actor       String
  action      String
  description String
  createdAt   DateTime @default(now())
}

model SystemMetrics {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  timestamp       DateTime @default(now())
  activeIncidents Int
  responseTime    Float
  successRate     Float
  systemHealth    String
  uptime          Int
}

model ServiceConnection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  service   String   @unique
  status    String   @default("connected")
  lastCheck DateTime @default(now())
  health    String   @default("healthy")
  updatedAt DateTime @updatedAt
}
